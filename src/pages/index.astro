---
import Layout from '@layouts/Layout.astro';
import AnnouncementBar from '@components/AnnouncementBar.astro';
import Header from '@components/Header.astro';
import Hero from '@components/Hero.astro';
import Benefits from '@components/Benefits.astro';
import Services from '@components/Services.astro';
import CtaBanner from '@components/CtaBanner.astro';
import HowToOrder from '@components/HowToOrder.astro';
import LocationContact from '@components/LocationContact.astro';
import Footer from '@components/Footer.astro';
import FloatingButtons from '@components/FloatingButtons.astro';
---

<Layout>
	<AnnouncementBar />
	<Header />
	<main id='contenido'>
		<Hero />
		<Benefits />
		<Services />
		<CtaBanner />
		<HowToOrder />
		<LocationContact />
	</main>
	<Footer />
	<FloatingButtons />
</Layout>

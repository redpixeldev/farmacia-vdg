---
const services = [
	{
		title: 'Despacho de recetas',
		desc: 'Envíanos la foto de tu récipe y preparamos tu pedido.',
		img: '/img/service-recetas.png',
	},
	{
		title: 'Medicamentos de venta libre',
		desc: 'Analgésicos, antigripales, vitaminas y más, siempre disponibles.',
		img: '/img/service-medicamentos.png',
	},
	{
		title: 'Cuidado personal e higiene',
		desc: 'Productos de cuidado, higiene y belleza para toda la familia.',
		img: '/img/service-cuidado-personal.png',
	},
	{
		title: 'Productos para bebés',
		desc: 'Pañales, fórmulas, cuidado e higiene infantil.',
		img: '/img/service-bebes.png',
	},
	{
		title: 'Vitaminas y suplementos',
		desc: 'Energía, defensas y bienestar para cada etapa de la vida.',
		img: '/img/service-vitaminas.png',
	},
	{
		title: 'Equipos médicos básicos',
		desc: 'Tensiómetros, termómetros, glucómetros y más.',
		img: '/img/service-equipos.png',
	},
];
---

<section
	id='servicios'
	aria-labelledby='servicios-title'
	class='py-16 sm:py-20'
>
	<div class='container'>
		<div class='mx-auto max-w-2xl text-center'>
			<p class='eyebrow'>
				<span class='h-px w-6 bg-brand-red'></span>
				Servicios
			</p>
			<h2
				id='servicios-title'
				class='mt-3 text-3xl font-extrabold text-ink sm:text-4xl'
			>
				Todo lo que tu familia necesita
			</h2>
			<p class='mt-3 text-ink-soft'>
				Una farmacia completa para el día a día. Pídelo por WhatsApp y te lo
				llevamos.
			</p>
		</div>

		<div class='services-swiper swiper mt-10'>
			<ul class='swiper-wrapper'>
				{
					services.map((s) => (
						<li class='swiper-slide h-auto'>
							<article class='flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5 transition-shadow hover:shadow-md'>
								<img
									src={s.img}
									alt={s.title}
									width='600'
									height='340'
									loading='lazy'
									class='aspect-[16/9] w-full object-cover'
								/>
								<div class='flex flex-1 flex-col p-5'>
									<h3 class='font-bold text-ink'>{s.title}</h3>
									<p class='mt-1.5 text-sm text-ink-soft'>{s.desc}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>
			<div
				class='services-pagination swiper-pagination mt-6 md:hidden'
				aria-hidden='true'
			>
			</div>
		</div>
	</div>
</section>

<script is:inline>
	function initServicesSwiper() {
		const el = document.querySelector('.services-swiper');
		if (!el || !window.Swiper) return;

		let instance = null;
		const mq = window.matchMedia('(max-width: 767px)');

		const sync = () => {
			if (mq.matches && !instance) {
				instance = new window.Swiper(el, {
					slidesPerView: 1.1,
					spaceBetween: 16,
					grabCursor: true,
					a11y: { enabled: true },
					pagination: {
						el: '.services-pagination',
						clickable: true,
					},
					breakpoints: {
						480: { slidesPerView: 1.4 },
						640: { slidesPerView: 2.1 },
					},
				});
			} else if (!mq.matches && instance) {
				instance.destroy(true, true);
				instance = null;
			}
		};

		sync();
		mq.addEventListener('change', sync);
	}

	if (window.Swiper) {
		initServicesSwiper();
	} else {
		window.addEventListener('load', initServicesSwiper);
	}
</script>

---
import { site } from '../config';
import WhatsappIcon from './WhatsappIcon.astro';
---

<section
	id='inicio'
	class='relative overflow-hidden bg-gradient-to-b from-white via-surface to-surface'
>
	<div class='container grid items-center gap-10 py-12 lg:grid-cols-2 lg:gap-12 lg:py-16'>
		<!-- Copy -->
		<div>
			<div class='flex flex-wrap gap-2'>
				<span class='inline-flex items-center gap-1.5 rounded-full bg-brand-red/10 px-3 py-1 text-xs font-semibold text-brand-red'>
					<svg
						class='h-3.5 w-3.5'
						viewBox='0 0 24 24'
						fill='currentColor'
						aria-hidden='true'><path d='M12 3 2 10h2v9h6v-5h4v5h6v-9h2L12 3Z'></path></svg>
					Delivery a domicilio
				</span>
				<span class='inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand'>
					<svg
						class='h-3.5 w-3.5'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						aria-hidden='true'><circle
							cx='12'
							cy='12'
							r='9'></circle><path
							stroke-linecap='round'
							d='M12 7v5l3 2'></path></svg>
					Abierto todos los días
				</span>
			</div>

			<h1 class='mt-5 text-4xl leading-[1.1] font-extrabold tracking-tight text-ink sm:text-5xl'>
				Tu farmacia de confianza, a un
				<span class='relative whitespace-nowrap text-brand-red'>
					mensaje
					<svg
						class='absolute -bottom-1 left-0 w-full'
						viewBox='0 0 100 8'
						preserveAspectRatio='none'
						aria-hidden='true'><path
							d='M1 5 C 25 1, 75 1, 99 5'
							fill='none'
							stroke='currentColor'
							stroke-width='2'
							stroke-linecap='round'></path></svg>
				</span>
				 de distancia.
			</h1>

			<p class='mt-5 max-w-md text-lg text-ink-soft'>
				Medicamentos, cuidado personal y más — pide por WhatsApp y te lo
				llevamos a casa en Santo Domingo.
			</p>

			<div class='mt-7 flex flex-col gap-3 sm:flex-row'>
				<a
					href={site.whatsapp.link}
					target='_blank'
					rel='noopener'
					class='btn btn-whatsapp px-6 py-3.5 text-base'
				>
					<WhatsappIcon class='h-5 w-5' />
					Pedir por WhatsApp
				</a>
				<a
					href={`tel:${site.phones[0].tel}`}
					class='btn btn-outline px-6 py-3.5 text-base'
				>
					<svg
						class='h-5 w-5'
						viewBox='0 0 24 24'
						fill='currentColor'
						aria-hidden='true'><path d='M6.62 10.79a15.53 15.53 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.02l-2.21 2.2Z'></path></svg>
					Llamar ahora
				</a>
			</div>

			<ul class='mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-soft'>
				<li class='flex items-center gap-2'>
					<span class='h-1.5 w-1.5 rounded-full bg-brand-green'></span>
					Atendido por farmacéuticos
				</li>
				<li class='flex items-center gap-2'>
					<span class='h-1.5 w-1.5 rounded-full bg-brand-green'></span>
					Pago: efectivo, tarjeta o transferencia
				</li>
			</ul>
		</div>

		<!-- Image -->
		<div class='relative'>
			<div class='absolute -top-3 -left-3 z-10 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-red text-white shadow-lg'>
				<svg
					class='h-7 w-7'
					viewBox='0 0 24 24'
					fill='currentColor'
					aria-hidden='true'><path d='M10 3h4v7h7v4h-7v7h-4v-7H3v-4h7V3Z'></path></svg>
			</div>

			<img
				src='/img/hero-pharmacist.png'
				alt='Farmacéutica de Farmacia VDG entregando un medicamento a una clienta en el mostrador'
				width='1232'
				height='1232'
				class='aspect-square w-full rounded-3xl object-cover shadow-xl ring-1 ring-black/5'
				fetchpriority='high'
			/>

			<div class='absolute right-4 -bottom-4 flex items-center gap-3 rounded-2xl bg-white p-3 pr-5 shadow-lg ring-1 ring-black/5 sm:right-6'>
				<span class='flex h-10 w-10 items-center justify-center rounded-xl bg-brand/10 text-brand'>
					<svg
						class='h-5 w-5'
						viewBox='0 0 24 24'
						fill='none'
						stroke='currentColor'
						stroke-width='2'
						aria-hidden='true'><circle
							cx='12'
							cy='12'
							r='9'></circle><path
							stroke-linecap='round'
							d='M12 7v5l3 2'></path></svg>
				</span>
				<div class='text-sm leading-tight'>
					<p class='font-bold text-ink'>Horario amplio</p>
					<p class='text-ink-soft'>{site.hoursShort.weekday}</p>
					<p class='text-ink-soft'>{site.hoursShort.sunday}</p>
				</div>
			</div>
		</div>
	</div>
</section>

---
import { site } from '../config';
import WhatsappIcon from './WhatsappIcon.astro';

const year = new Date().getFullYear();
---

<footer class='border-t-4 border-brand-red bg-footer text-white/80'>
	<div class='container grid gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4'>
		<div>
			<span class='inline-flex rounded-xl bg-white px-3 py-2'>
				<img
					src='/img/logo.svg'
					alt={site.name}
					width='150'
					height='41'
					class='h-8 w-auto'
				/>
			</span>
			<p class='mt-4 max-w-xs text-sm'>
				Tu farmacia de confianza en Santo Domingo. Pide por WhatsApp y te lo
				llevamos a casa.
			</p>
			<div class='mt-4 flex gap-3'>
				<a
					href={site.instagram.url}
					target='_blank'
					rel='noopener'
					class='flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20'
					aria-label={`Instagram ${site.instagram.handle}`}
				>
					<svg
						class='h-5 w-5'
						viewBox='0 0 24 24'
						fill='currentColor'
						aria-hidden='true'><path d='M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.8.22 2.43.47.66.25 1.22.6 1.77 1.15.55.55.9 1.11 1.15 1.77.25.63.42 1.36.47 2.43C21.99 8.94 22 9.28 22 12s-.01 3.06-.06 4.12c-.05 1.07-.22 1.8-.47 2.43-.25.66-.6 1.22-1.15 1.77-.55.55-1.11.9-1.77 1.15-.63.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.12-.06c-1.07-.05-1.8-.22-2.43-.47a4.9 4.9 0 0 1-1.77-1.15 4.9 4.9 0 0 1-1.15-1.77c-.25-.63-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.8.47-2.43.25-.66.6-1.22 1.15-1.77.55-.55 1.11-.9 1.77-1.15.63-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2Zm0 1.8c-2.67 0-2.99.01-4.04.06-.98.04-1.5.21-1.86.34-.47.18-.8.4-1.15.75-.35.35-.57.68-.75 1.15-.13.36-.3.88-.34 1.86-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.04.98.21 1.5.34 1.86.18.47.4.8.75 1.15.35.35.68.57 1.15.75.36.13.88.3 1.86.34 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.98-.04 1.5-.21 1.86-.34.47-.18.8-.4 1.15-.75.35-.35.57-.68.75-1.15.13-.36.3-.88.34-1.86.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.98-.21-1.5-.34-1.86a3.1 3.1 0 0 0-.75-1.15 3.1 3.1 0 0 0-1.15-.75c-.36-.13-.88-.3-1.86-.34-1.05-.05-1.37-.06-4.04-.06Zm0 3.07a5.13 5.13 0 1 1 0 10.26 5.13 5.13 0 0 1 0-10.26Zm0 8.46a3.33 3.33 0 1 0 0-6.66 3.33 3.33 0 0 0 0 6.66Zm5.34-8.66a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4Z'></path></svg>
				</a>
				<a
					href={site.whatsapp.link}
					target='_blank'
					rel='noopener'
					class='flex h-10 w-10 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20'
					aria-label='Escríbenos por WhatsApp'
				>
					<WhatsappIcon class='h-5 w-5' />
				</a>
			</div>
		</div>

		<div class='lg:col-start-3'>
			<h2 class='font-heading text-sm font-bold tracking-wider text-white uppercase'>Navegación</h2>
			<ul class='mt-4 space-y-2.5 text-sm'>
				{
					site.nav.map((item) => (
						<li>
							<a
								href={item.href}
								class='transition-colors hover:text-white'
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<div>
			<h2 class='font-heading text-sm font-bold tracking-wider text-white uppercase'>Contacto</h2>
			<ul class='mt-4 space-y-2.5 text-sm'>
				{
					site.phones.map((p) => (
						<li>
							<a
								href={`tel:${p.tel}`}
								class='transition-colors hover:text-white'
							>
								{p.display}
								{p.whatsapp && ' · WhatsApp'}
							</a>
						</li>
					))
				}
				<li>
					<a
						href={`mailto:${site.email}`}
						class='transition-colors hover:text-white'
					>
						{site.email}
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class='border-t border-white/10'>
		<div class='container flex flex-col items-center justify-between gap-2 py-5 text-sm text-white/60 sm:flex-row'>
			<p>© {year} {site.name}. Todos los derechos reservados.</p>
			<p>{site.city}</p>
		</div>
	</div>
</footer>

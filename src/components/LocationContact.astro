---
import { site } from '../config';
import WhatsappIcon from './WhatsappIcon.astro';
---

<section
	id='contacto'
	aria-labelledby='contacto-title'
	class='pt-10 pb-16 sm:pb-20'
>
	<div class='container'>
		<div class='mx-auto max-w-2xl text-center'>
			<p class='eyebrow'>
				<span class='h-px w-6 bg-brand-red'></span>
				Horarios y contacto
			</p>
			<h2
				id='contacto-title'
				class='mt-3 text-3xl font-extrabold text-ink sm:text-4xl'
			>
				Estamos cerca de ti
			</h2>
		</div>

		<div class='mt-10 grid gap-6 lg:grid-cols-2'>
			<!-- Info card -->
			<div class='rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5 sm:p-8'>
				<h3 class='text-sm font-bold tracking-wider text-brand uppercase'>Horario</h3>
				<dl class='mt-3 divide-y divide-slate-100'>
					{
						site.hours.map((h) => (
							<div class='flex items-center justify-between py-2.5'>
								<dt class='text-ink-soft'>{h.label}</dt>
								<dd class='font-semibold text-ink'>{h.value}</dd>
							</div>
						))
					}
				</dl>

				<h3 class='mt-6 text-sm font-bold tracking-wider text-brand uppercase'>Teléfonos</h3>
				<ul class='mt-3 space-y-2'>
					{
						site.phones.map((p) => (
							<li class='flex items-center gap-2'>
								<span
									class={`h-2 w-2 shrink-0 rounded-full ${p.whatsapp ? 'bg-whatsapp' : 'bg-brand-green'}`}
								/>
								<a
									href={`tel:${p.tel}`}
									class='font-semibold text-ink hover:text-brand'
								>
									{p.display}
								</a>
								{p.whatsapp && <span class='text-sm text-ink-soft'>· WhatsApp</span>}
							</li>
						))
					}
				</ul>

				<h3 class='mt-6 text-sm font-bold tracking-wider text-brand uppercase'>Email y ubicación</h3>
				<p class='mt-3'>
					<a
						href={`mailto:${site.email}`}
						class='font-semibold text-ink hover:text-brand'
					>
						{site.email}
					</a>
				</p>
				<p class='mt-1 text-ink-soft'>{site.address}</p>

				<a
					href={site.whatsapp.link}
					target='_blank'
					rel='noopener'
					class='btn btn-whatsapp mt-6 w-full px-6 py-3.5 text-base'
				>
					<WhatsappIcon class='h-5 w-5' />
					Pedir por WhatsApp
				</a>
			</div>

			<!-- Map -->
			<div class='overflow-hidden rounded-2xl shadow-sm ring-1 ring-black/5'>
				<iframe
					src={site.mapEmbed}
					title={`Ubicación de ${site.name} en ${site.address}`}
					class='h-full min-h-[360px] w-full border-0'
					loading='lazy'
					referrerpolicy='no-referrer-when-downgrade'
				></iframe>
			</div>
		</div>
	</div>
</section>

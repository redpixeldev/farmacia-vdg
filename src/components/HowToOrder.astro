---
const steps = [
	{
		n: '1',
		title: 'Escríbenos por WhatsApp',
		desc: 'Mándanos tu lista o la foto de tu récipe. Te respondemos al momento.',
	},
	{
		n: '2',
		title: 'Confirma pedido y dirección',
		desc: 'Te confirmamos disponibilidad, total y tiempo de entrega.',
	},
	{
		n: '3',
		title: 'Recíbelo en casa',
		desc: 'Recibe tu pedido en menos tiempo',
	},
];
---

<section
	id='como-pedir'
	aria-labelledby='como-pedir-title'
	class='py-16 sm:py-20'
>
	<div class='container'>
		<div class='mx-auto max-w-2xl text-center'>
			<p class='eyebrow'>
				<span class='h-px w-6 bg-brand-red'></span>
				Cómo pedir
			</p>
			<h2
				id='como-pedir-title'
				class='mt-3 text-3xl font-extrabold text-ink sm:text-4xl'
			>
				Tu pedido en 3 pasos
			</h2>
		</div>

		<ol class='mt-10 grid gap-6 md:grid-cols-3'>
			{
				steps.map((s) => (
					<li class='rounded-2xl bg-white p-6 shadow-sm ring-1 ring-black/5'>
						<span class='flex h-10 w-10 items-center justify-center rounded-xl bg-brand-red text-lg font-extrabold text-white'>
							{s.n}
						</span>
						<h3 class='mt-4 font-bold text-ink'>{s.title}</h3>
						<p class='mt-1.5 text-sm text-ink-soft'>{s.desc}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

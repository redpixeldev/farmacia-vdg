---
import { site } from '../config';
import WhatsappIcon from './WhatsappIcon.astro';
---

<div class='fixed right-4 bottom-4 z-50 flex flex-col items-end gap-3 sm:right-6 sm:bottom-6'>
	<a
		href={`tel:${site.phones[2].tel}`}
		class='flex h-12 w-12 items-center justify-center rounded-full bg-brand-red text-white shadow-lg ring-1 ring-black/5 transition-transform hover:scale-105'
		aria-label={`Llamar para urgencias ${site.phones[2].display}`}
	>
		<svg
			class='h-5 w-5'
			viewBox='0 0 24 24'
			fill='currentColor'
			aria-hidden='true'><path d='M6.62 10.79a15.53 15.53 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.02l-2.21 2.2Z'></path></svg>
	</a>
	<a
		href={site.whatsapp.link}
		target='_blank'
		rel='noopener'
		class='btn btn-whatsapp px-5 py-3 shadow-lg ring-1 ring-black/5'
		aria-label='Pedir por WhatsApp'
	>
		<WhatsappIcon class='h-5 w-5' />
		<span class='hidden sm:inline'>Pedir</span>
	</a>
</div>

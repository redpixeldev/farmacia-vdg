---
import { site } from '../config';
---

<div class='bg-brand-red text-white'>
	<div class='container flex flex-col items-center justify-center gap-1 py-2 text-center text-xs font-medium sm:flex-row sm:gap-6 sm:text-sm'>
		<p class='flex items-center gap-2'>
			<svg
				class='h-4 w-4 shrink-0'
				viewBox='0 0 24 24'
				fill='currentColor'
				aria-hidden='true'
			>
				<path
					d='M6.62 10.79a15.53 15.53 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.24 1.02l-2.21 2.2Z'
				></path>
			</svg>
			<span>
				Línea directa para pedidos urgentes:
				<a
					href={`tel:${site.whatsapp.display.replace(/-/g, '')}`}
					class='font-bold underline-offset-2 hover:underline'
				>
					{site.whatsapp.display}
				</a>
			</span>
		</p>
		<p class='hidden items-center gap-2 sm:flex'>
			<svg
				class='h-4 w-4 shrink-0'
				viewBox='0 0 24 24'
				fill='currentColor'
				aria-hidden='true'
			>
				<path d='M3 13h1l1.5-4.5A2 2 0 0 1 7.4 7h6.2a2 2 0 0 1 1.9 1.5L17 13h1a2 2 0 0 1 2 2v3h-2a2 2 0 1 1-4 0H9a2 2 0 1 1-4 0H3v-5Zm4.4-4-.9 3h7l-.9-3H7.4Z'></path>
			</svg>
			Entrega cómoda y segura
		</p>
	</div>
</div>
